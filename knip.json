{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/index.ts",
    "src/platform/deno/index.ts",
    "src/platform/web/index.ts",
    "src/__tests__/**/*.ts",
    "src/**/__tests__/**/*.ts",
    "bench/page/smoke.ts",
    "bench/page/main.ts",
    "bench/vite.config.ts",
    "bench/**/__tests__/**/*.ts"
  ],
  "project": ["src/**/*.ts", "bench/**/*.ts"],
  "ignore": [
    "clay-engine-doc/**",
    "dist/**",
    "docs/**",
    "**/*.wgsl",
    "src/__smokes__/**",
    "bench/results/**",
    "**/zz*.ts",
    "bench/page/agua.ts"
  ],
  "ignoreDependencies": [
    "@types/gl-matrix",
    "@types/uuid",
    "@typescript-eslint/eslint-plugin",
    "@typescript-eslint/parser",
    "docusaurus-plugin-typedoc"
  ],
  "rules": {
    "exports": "warn",
    "types": "warn",
    "nsExports": "warn",
    "nsTypes": "warn",
    "enumMembers": "warn",
    "duplicates": "warn",
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error"
  }
}
